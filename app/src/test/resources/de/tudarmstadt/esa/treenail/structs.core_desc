InstructionSet Structs {
  architectural_state {
    struct Simple {
      unsigned<32> x, y;
      signed<16> a, b, c, d;
    }
    struct Nested {
      unsigned<32> notNested;
      struct Simple nested;
    }

    struct TripleNested {
      unsigned<32> notNestedAgain;
      struct Nested nested2;
    }
  }

  functions {
    // Function with struct return type
    struct Simple makeSimple(unsigned<32> x, unsigned<32> y) {
      struct Simple res;
      res.x = x;
      res.y = y;
      return res;
    }
    // Function with struct argument
    unsigned<64> convertSimple(struct Simple arg) {
      unsigned<64> retVal = arg.x * arg.y;
      retVal += (unsigned<32>)(arg.a * arg.b);
      retVal *= (unsigned<32>)(arg.c / arg.d);
      return retVal;
    }
    // Function with both struct arguments and struct return type
    struct Nested makeNested(unsigned<32> notNested, struct Simple simple) {
        struct Nested res;
        res.notNested = notNested;
        res.nested = simple;
        return res;
    }
  }

  instructions {
    StructTest {
      encoding: imm[11:0] :: rs1[4:0] :: 3'b010 :: rd[4:0] :: 7'b0000011;
      behavior: {
        struct Simple localStruct;
        // Member access
        localStruct.x = 10;
        localStruct.c = -1;
        localStruct.x -= rs1;
        struct Nested nestedStruct;
        // Nested access
        nestedStruct.nested = localStruct;
        nestedStruct.nested.b = 42;
        struct TripleNested triple;
        triple.nested2 = nestedStruct;
        triple.nested2.nested = localStruct;
        triple.nested2.nested.d = 67;
        // bit access to members
        localStruct.y[4:0] = 3;
        triple.nested2.nested.c[7:0] = 42;
        // function calls
        struct Simple simple = makeSimple(6, 7);
        unsigned<64> converted = convertSimple(simple);
        struct Nested nested = makeNested(10, simple);
        // Struct modified in switch statement
        switch (converted) {
          case 10:
            simple.x = 10;
            break;
          case 3:
            simple.y = 10;
            break;
          default:
            break;
        }
        nested.nested = simple;
      }
    }
  }
}
